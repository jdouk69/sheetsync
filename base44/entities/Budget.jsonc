{
  "name": "Budget",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Budget name (e.g. Cabinets, Labor, Plumbing)"
    },
    "projectId": {
      "type": "string",
      "description": "ID of the associated project"
    },
    "month": {
      "type": "string",
      "description": "Optional month for the budget in YYYY-MM format"
    },
    "amount": {
      "type": "number",
      "description": "Budget limit in project currency"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes about this budget"
    },
    "backupRestoreKey": {
      "type": "string",
      "description": "Internal identifier for retrying copy restores"
    }
  },
  "required": [
    "name",
    "projectId",
    "amount"
  ]
}